{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch aiPlayground",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build AiPlayground",
      "cwd": "${workspaceFolder}/AiPlayground",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/AiPlayground/bin/Debug/net10.0/AiPlayground.dll"
    }
  ]
}


